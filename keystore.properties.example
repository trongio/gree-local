# Copy to keystore.properties (gitignored) and fill in the two passwords.
#
# This points at the same upload key already used for the Prava app. Google permits one
# upload key across several apps in an account, and reusing it means one less secret to
# lose. Use a separate key instead if you ever want to hand one app to someone else.
storeFile=/home/azael/Documents/GitHub/PHPNative-DrivingTest-app/credentials/app-release-key.jks
storePassword=
keyAlias=app-key
keyPassword=
