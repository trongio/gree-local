<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/w_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/albert_sans"
            android:textSize="14sp"
            android:textColor="@color/w_ink"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/w_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/albert_sans"
            android:textSize="38sp"
            android:includeFontPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/w_ink"
            android:maxLines="1"
            android:text="--" />

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_mono_regular"
            android:textSize="10sp"
            android:textColor="@color/w_ink2"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <ImageView
        android:id="@+id/w_minus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_btn"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_minus"
        android:contentDescription="@string/w_cooler" />

    <ImageView
        android:id="@+id/w_plus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_btn"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_plus"
        android:contentDescription="@string/w_warmer" />

    <ImageView
        android:id="@+id/w_power"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_btn"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_power"
        android:contentDescription="@string/w_power" />
</LinearLayout>
